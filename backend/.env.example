# ---- Telegram (free) : https://my.telegram.org -> API development tools ----
TG_API_ID=
TG_API_HASH=
# Phone number used once by `npm run telegram:login` (international format, e.g. +919876543210)
TG_PHONE=

# ---- Model: Azure OpenAI if these are set, else Groq below ----
# The same deployment our other SIH build uses. Reasoning deployments accept max_completion_tokens
# and reasoning_effort; set AZURE_REASONING_EFFORT= (empty) if yours rejects the parameter.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_REASONING_EFFORT=low
# LLM_PROVIDER=azure|groq (default: azure when the Azure key is set); LLM_TPM paces requests (default 60000 azure / 8000 groq)

# ---- Groq (free tier) : https://console.groq.com/keys ----
GROQ_API_KEY=
# Bulk per-message / per-user labelling. Check https://console.groq.com/docs/models for current names.
GROQ_MODEL=openai/gpt-oss-20b
# Short narrative summaries on the dashboard (few calls, so a larger model is fine)
GROQ_INSIGHTS_MODEL=openai/gpt-oss-120b

# ---- X (Twitter) via Apify : https://console.apify.com/account/integrations ----
# The free/starter credit is what the demo runs on; the budget below stops collection before it is gone.
APIFY_TOKEN=
APIFY_ACTOR=apidojo~tweet-scraper
X_BACKFILL_LIMIT=300
X_SYNC_LIMIT=60
X_THREADS_PER_CYCLE=3
X_THREAD_LIMIT=40
X_MONTHLY_BUDGET_USD=15
# Instagram profiles and Facebook pages use Apify's own scrapers on the same token and budget.
META_POSTS_PER_SOURCE=12
META_COMMENTS_PER_POST=50
META_THREADS_PER_CYCLE=2

# ---- Reddit : https://www.reddit.com/prefs/apps -> create app (type "script") ----
# Free, 100 requests/min. Without these the collector uses the public feeds, which Reddit throttles.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_BACKFILL_LIMIT=200
REDDIT_THREADS_PER_CYCLE=5

# ---- YouTube : Google Cloud console -> enable "YouTube Data API v3" -> credentials -> API key ----
# Free, 10,000 units/day (a page of 100 comments is 1 unit).
YOUTUBE_API_KEY=
YOUTUBE_VIDEOS_PER_CHANNEL=10
YOUTUBE_COMMENTS_PER_VIDEO=300

# ---- Sign-in ----
# One shared password for the dashboard and API. Leave empty for an open API on a laptop; set it on any host.
APP_PASSWORD=
# Optional: signing secret for session tokens (derived from the password when empty).
APP_SECRET=

# ---- Pipeline tuning (keep small to stay inside free-tier limits) ----
PORT=4000
SYNC_INTERVAL_SEC=300
BACKFILL_LIMIT=500
BACKFILL_DAYS=30
ANALYZE_PER_CYCLE=200
PROFILE_PER_CYCLE=40
BIO_FETCH_PER_CYCLE=30
